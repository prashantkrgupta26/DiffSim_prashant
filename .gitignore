# --- git worktrees (local isolation, never track) ---
.worktrees/

# --- Python / env ---
.venv/
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/

# --- build artifacts (setuptools/mkdocs output; regenerated) ---
build/
site/

# --- editor / OS ---
.DS_Store
.claude/
.remember/
.superpowers/

# --- private / external (do NOT ship: copyrighted papers, vendored deps) ---
MyPapers/
mypapers/
extern/

# --- large runtime data drops (regenerated on cluster; keep out of git) ---
benchmarks/data/wodo_nova/
docs/dev/nova-mirrors/**/*.npy
docs/dev/nova-mirrors/**/*.npz

# --- generated docs site content (from tutorials/build_site.py) ---
docs/site_src/

# --- tutorial viz output (tutorials/_viz.py writes here; never commit PNGs/VTUs) ---
tutorials/*/figures/
tutorials/*/*/figures/

# --- paper drafts (local only; NEVER push) ---
papers/
paper-outlines-*.tar.gz
benchmarks/data/negi2018/

# --- private review material (never push) ---
CriticalEvaluations/
previous_codes/

# Reference C++/MPI group codes (Dendrite-kt), large binaries — parity anchors, not tracked
local_code_old/

# Simulation/viz outputs — sync to home mac via Dropbox, not tracked
results/
